{"text": "<style>\n.sc { --pista: #93c572; --pista-deep: #5e8c3a; --plum: #7b3f61; --shell: #efe5cf;\n  display: grid; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n.sc a { color: inherit; }\n.sc-head { display: grid; gap: var(--cds-gap-xs); padding: var(--cds-pad-lg); border-radius: var(--cds-radius);\n  background: linear-gradient(120deg, color-mix(in srgb, var(--pista) 30%, var(--color-panel)), color-mix(in srgb, var(--shell) 45%, var(--color-panel))); border: 1px solid color-mix(in srgb, var(--pista) 45%, var(--color-border-line)); }\n.sc-title { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; }\n.sc-take { margin: 0; max-width: 72ch; font-size: var(--cds-font-size-body); }\n.sc-take b { font-weight: 600; }\n.sc-links { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm); margin-top: var(--cds-gap-xs); }\n.sc-link { font-size: var(--cds-font-size-caption); padding: 4px 10px; border-radius: 999px; text-decoration: none; background: var(--color-panel); border: 1px solid var(--color-border-line); }\n.sc-link:hover, .sc-link:focus-visible { border-color: var(--pista-deep); }\n.sc-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: var(--cds-gap-md); }\n.sc-tile { display: grid; gap: 4px; align-content: start; padding: var(--cds-pad-lg); border-radius: var(--cds-radius); background: var(--color-panel); border: 1px solid var(--color-border-line); border-top: 4px solid var(--pista); min-width: 0; }\n.sc-tile.plum { border-top-color: var(--plum); }\n.sc-tile.shell { border-top-color: color-mix(in srgb, var(--shell) 70%, var(--plum)); }\n.sc-label { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.sc-num { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; min-height: 1.3em; }\n.sc-sub { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n.sc-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n.sc-card h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0 0 4px; }\n.sc-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: 0 0 var(--cds-gap-md); }\n.sc-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-bottom: var(--cds-gap-sm); }\n.sc-legend span { display: inline-flex; align-items: center; gap: 6px; }\n.sc-legend i { width: 18px; height: 8px; border-radius: 4px; display: inline-block; }\n.sc-filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--cds-gap-sm); }\n.sc-chip { font: inherit; font-size: var(--cds-font-size-caption); padding: 4px 10px; border-radius: 999px; border: 1px solid var(--color-border-line); background: var(--color-bg); color: var(--color-fg); cursor: pointer; }\n.sc-chip[aria-pressed=\"true\"] { background: color-mix(in srgb, var(--pista) 35%, var(--color-panel)); border-color: var(--pista-deep); }\n.sc-chip:focus-visible { outline: 2px solid var(--pista-deep); outline-offset: 1px; }\n.sc-tablebox { overflow-x: auto; }\n.sc-table { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n.sc-table th { text-align: left; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); padding: 6px 8px; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.sc-table td { padding: 8px; border-bottom: 1px solid var(--color-border-line); vertical-align: middle; }\n.sc-table tr:last-child td { border-bottom: 0; }\n.sc-table .n { text-align: right; }\n.sc-id { display: inline-block; font-size: 11px; font-weight: 600; padding: 1px 6px; border-radius: 4px; background: color-mix(in srgb, var(--plum) 18%, var(--color-panel)); margin-right: 6px; }\n.sc-what { min-width: 13rem; }\n.sc-meta { color: var(--color-fg-muted); white-space: nowrap; }\n.sc-pill { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 600; white-space: nowrap; }\n.sc-pill.ready { background: color-mix(in srgb, var(--pista) 40%, var(--color-panel)); }\n.sc-pill.confirm { background: color-mix(in srgb, var(--shell) 85%, var(--plum) 15%); color: #3d2a1f; }\n.sc-pill.posted { background: var(--plum); color: #fff; }\n.sc-pill.skipped { background: var(--color-bg); color: var(--color-fg-muted); border: 1px solid var(--color-border-line); }\n.sc-bars { display: grid; gap: 3px; min-width: 9rem; }\n.sc-bar { height: 8px; border-radius: 4px; }\n.sc-bar.ref { background: var(--plum); }\n.sc-bar.ours { background: var(--pista); }\n.sc-bar.none { background: repeating-linear-gradient(90deg, var(--color-border-line) 0 4px, transparent 4px 8px); }\n.sc-posts { display: grid; gap: 0; }\n.sc-post { display: grid; grid-template-columns: 5.5rem 1fr auto; gap: var(--cds-gap-sm); align-items: center; padding: 8px 0; border-bottom: 1px solid var(--color-border-line); font-size: var(--cds-font-size-caption); }\n.sc-post:last-child { border-bottom: 0; }\n.sc-post .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }\n.sc-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }\n.sc-score { font-weight: 600; padding: 2px 8px; border-radius: 999px; background: var(--color-bg); border: 1px solid var(--color-border-line); }\n.sc-score.hot { background: var(--pista); border-color: var(--pista); color: #1f2e14; }\n.sc-more { margin-top: var(--cds-gap-sm); }\n.sc-medians { display: flex; flex-wrap: wrap; gap: var(--cds-gap-sm); margin-bottom: var(--cds-gap-sm); }\n.sc-median { font-size: var(--cds-font-size-caption); padding: 4px 10px; border-radius: var(--cds-radius); background: color-mix(in srgb, var(--shell) 50%, var(--color-panel)); }\n.sc-fail { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 4rem; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.sc-fail::before { content: \"\"; width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); }\n.sc-empty { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); padding: var(--cds-pad-sm) 0; }\n[data-dash-source-state=empty] { color: transparent; }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n@media (max-width: 40rem) { .sc-table .wide { display: none; } .sc-post { grid-template-columns: 1fr auto; } .sc-post .d { display: none; } }\n</style>\n\n<div class=\"sc\">\n  <header class=\"sc-head\" id=\"top\">\n    <h1 class=\"sc-title\">Scooby performance</h1>\n    <p class=\"sc-take dash-skeleton\" id=\"take\" data-source=\"summary\"></p>\n    <div class=\"sc-links\">\n      <a class=\"sc-link\" href=\"https://app.notion.com/p/f1e399ae01054047a6fc3d5831efc32d\" target=\"_blank\" rel=\"noopener\">Swipes in Notion</a>\n      <a class=\"sc-link\" href=\"https://app.notion.com/p/a55e99c7a0fc40db8f055168bd22332f\" target=\"_blank\" rel=\"noopener\">Our posts in Notion</a>\n    </div>\n  </header>\n\n  <section class=\"sc-tiles\" id=\"tiles\" aria-label=\"Headline figures\">\n    <div class=\"sc-tile\">\n      <span class=\"sc-label\">Swipes written</span>\n      <span class=\"sc-num dash-skeleton\" data-source=\"summary\" data-field=\"written\" data-row=\"0\"></span>\n      <span class=\"sc-sub\"><span data-source=\"summary\" data-field=\"ready\" data-row=\"0\"></span> ready, <span data-source=\"summary\" data-field=\"needs_confirmation\" data-row=\"0\"></span> need a check</span>\n    </div>\n    <div class=\"sc-tile plum\">\n      <span class=\"sc-label\">Swipes posted</span>\n      <span class=\"sc-num dash-skeleton\" data-source=\"summary\" data-field=\"posted\" data-row=\"0\"></span>\n      <span class=\"sc-sub\">Found on our X, LinkedIn and Instagram by Scooby</span>\n    </div>\n    <div class=\"sc-tile shell\">\n      <span class=\"sc-label\">Swipe posts vs our usual</span>\n      <span class=\"sc-num dash-skeleton\" data-source=\"summary\" data-field=\"median_swipe\" data-row=\"0\"></span>\n      <span class=\"sc-sub\">Other posts: <span data-source=\"summary\" data-field=\"median_other\" data-row=\"0\"></span> \u00b7 1x = our usual post</span>\n    </div>\n  </section>\n\n  <section class=\"sc-card\" id=\"tracker\">\n    <h2>Swipe tracker</h2>\n    <p class=\"sc-note\">Each swipe, the post it was built on, and how our version did once Scooby found it on our accounts. Scores compare a post with its own account's usual post.</p>\n    <div class=\"sc-legend\"><span><i style=\"background:var(--plum)\"></i>Reference score</span><span><i style=\"background:var(--pista)\"></i>Our score</span></div>\n    <div class=\"sc-filters\" role=\"group\" aria-label=\"Filter swipes\">\n      <button type=\"button\" class=\"sc-chip\" data-f=\"all\" aria-pressed=\"true\">All</button>\n      <button type=\"button\" class=\"sc-chip\" data-f=\"Ready\" aria-pressed=\"false\">Ready</button>\n      <button type=\"button\" class=\"sc-chip\" data-f=\"Needs confirmation\" aria-pressed=\"false\">Needs a check</button>\n      <button type=\"button\" class=\"sc-chip\" data-f=\"Posted\" aria-pressed=\"false\">Posted</button>\n    </div>\n    <div class=\"sc-tablebox\">\n      <table class=\"sc-table\" id=\"swipe-table\" data-source=\"tracker\" data-row-key=\"swipe_url\">\n        <thead><tr>\n          <th data-field=\"swipe\">Swipe</th>\n          <th data-field=\"platform\" class=\"wide\">Where</th>\n          <th data-field=\"status\">Status</th>\n          <th data-field=\"reference_score\" class=\"n\">Reference</th>\n          <th data-field=\"our_score\" class=\"n\">Ours</th>\n          <th data-field=\"vs_reference\" class=\"wide\">Compared</th>\n        </tr></thead>\n        <tbody></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"sc-card\" id=\"ours\">\n    <h2>Our latest posts</h2>\n    <p class=\"sc-note\">Every Tagada post on X, LinkedIn and Instagram, numbers pulled by Scooby each morning. Green means 3x our usual post or more.</p>\n    <div class=\"sc-medians\" id=\"medians\" data-source=\"by_platform\"></div>\n    <div class=\"sc-posts\" id=\"post-list\" data-source=\"scored\"></div>\n    <button type=\"button\" class=\"sc-chip sc-more\" id=\"more\" hidden>Show all posts</button>\n  </section>\n</div>\n\n<script>\nconst scClean = (v) => (v === null || v === undefined ? '' : String(v).replace(/\\\\([$#*_\\[\\]])/g, '$1').replace(/<br\\s*\\/?>/g, '\\n'));\nconst scNum = (v) => (v === null || v === undefined || v === '' ? null : Number(v));\nconst scParse = (a) => {\n  if (typeof a === 'string') {\n    try { a = JSON.parse(a); } catch (e) { throw new Error(a.slice(0, 300)); }\n  }\n  if (a && a.error) throw new Error(a.error.message || JSON.stringify(a.error).slice(0, 300));\n  if (!a || !Array.isArray(a.results)) throw new Error('Unexpected answer from Notion, keys: ' + Object.keys(a || {}).join(', '));\n  return a;\n};\nconst scAllPages = async (answer, call, args) => {\n  let page = scParse(answer);\n  const results = [...page.results];\n  let pages = 1;\n  while (page.has_more && page.next_cursor && pages < 5) {\n    page = scParse(await call('notion-query-data-sources', { data: { ...args.data, start_cursor: page.next_cursor } }));\n    results.push(...page.results);\n    pages += 1;\n  }\n  return { results, cut: Boolean(page.has_more) };\n};\n\ndash.loader('posts', {\n  description: 'Every page of the Our Posts view as one table: one row per post, numbers as numbers, the checkbox as true or false.',\n  fn: async ({ answer, call, args }) => {\n    const { results, cut } = await scAllPages(answer, call, args);\n    const rows = results.map((r) => ({\n      notion_url: scClean(r.url), post: scClean(r['Post']), brand: scClean(r['Brand']), platform: scClean(r['Platform']),\n      account: scClean(r['Account']), posted: scClean(r['date:Posted:start']).slice(0, 10), link: scClean(r['Link']),\n      from_swipe: r['From a swipe'] === '__YES__', swipe_id: scClean(r['Swipe ID']), reference_score: scNum(r['Reference score']),\n      likes: scNum(r['Likes']), comments: scNum(r['Comments']), reposts: scNum(r['Reposts']), impressions: scNum(r['Impressions']),\n      clicks: scNum(r['Clicks']), account_median: scNum(r['Account median']), metrics_updated: scClean(r['date:Metrics updated:start']).slice(0, 10),\n    }));\n    return { columns: Object.keys(rows[0] || { notion_url: '' }), rows, cut };\n  },\n});\n\ndash.loader('swipes', {\n  description: 'Every page of the Swipes view as one table: one row per swipe, scores as numbers, Notion escapes removed from the text.',\n  fn: async ({ answer, call, args }) => {\n    const { results, cut } = await scAllPages(answer, call, args);\n    const rows = results.map((r) => ({\n      swipe_url: scClean(r.url), swipe_id: scClean(r['Swipe ID']), swipe: scClean(r['Swipe']), brand: scClean(r['Brand']),\n      platform: scClean(r['Platform']), status: scClean(r['Status']), written: scClean(r['date:Written:start']).slice(0, 10),\n      reference_link: scClean(r['Reference link']), reference_score: scNum(r['Reference score']), posted_link: scClean(r['Posted link']),\n      saved_score: scNum(r['Our score']), matched_by: scClean(r['Matched by']),\n    }));\n    return { columns: Object.keys(rows[0] || { swipe_url: '' }), rows, cut };\n  },\n});\n\ndash.calc('scored', {\n  title: 'Our posts, scored',\n  description: 'Engagement = likes + 2 \u00d7 comments + 3 \u00d7 reposts; score = engagement \u00f7 that account\\'s usual post (its median).',\n  inputs: ['posts'],\n  fn: (posts) => posts.map((p) => {\n    const engagement = (p.likes || 0) + 2 * (p.comments || 0) + 3 * (p.reposts || 0);\n    return { ...p, engagement, score: p.account_median > 0 ? Math.round((engagement / p.account_median) * 10) / 10 : null };\n  }),\n});\n\ndash.calc('tracker', {\n  title: 'Swipes with our results',\n  description: 'Each swipe joined to our post at its posted link; our score is that post\\'s live score, and compared = our score \u00f7 the reference score.',\n  inputs: ['swipes', 'scored'],\n  fn: (swipes, scored) => swipes.map((s) => {\n    const post = scored.find((p) => s.posted_link && p.link === s.posted_link);\n    const our_score = post ? post.score : s.saved_score;\n    return { ...s, our_score, vs_reference: our_score !== null && s.reference_score > 0 ? Math.round((our_score / s.reference_score) * 100) / 100 : null };\n  }),\n});\n\ndash.calc('by_platform', {\n  title: 'Our posts by platform',\n  description: 'Per platform: how many of our posts, the best score, and how many reached 3x our usual post.',\n  inputs: ['scored'],\n  fn: (scored) => {\n    const groups = {};\n    scored.forEach((p) => { if (p.score !== null) (groups[p.platform] = groups[p.platform] || []).push(p.score); });\n    return Object.entries(groups).map(([platform, xs]) => {\n      const s = xs.slice().sort((a, b) => a - b), m = Math.floor(s.length / 2);\n      return { platform, posts: s.length, best: s[s.length - 1], outliers: s.filter((x) => x >= 3).length };\n    }).sort((a, b) => a.platform.localeCompare(b.platform));\n  },\n});\n\ndash.calc('summary', {\n  title: 'Headline figures',\n  description: 'Counts of swipes by status, and the median score of posts built on a swipe against the rest.',\n  inputs: ['tracker', 'scored'],\n  fn: (tracker, scored) => {\n    const median = (xs) => {\n      const s = xs.filter((x) => x !== null && x !== undefined).sort((a, b) => a - b);\n      if (!s.length) return null;\n      const m = Math.floor(s.length / 2);\n      return s.length % 2 ? s[m] : Math.round(((s[m - 1] + s[m]) / 2) * 10) / 10;\n    };\n    const postedLinks = new Set(tracker.filter((s) => s.posted_link).map((s) => s.posted_link));\n    const swipePosts = scored.filter((p) => p.from_swipe || postedLinks.has(p.link));\n    const others = scored.filter((p) => !(p.from_swipe || postedLinks.has(p.link)));\n    const best = scored.reduce((b, p) => (p.score !== null && (!b || p.score > b.score) ? p : b), null);\n    return [{\n      written: tracker.length,\n      ready: tracker.filter((s) => s.status === 'Ready').length,\n      needs_confirmation: tracker.filter((s) => s.status === 'Needs confirmation').length,\n      posted: tracker.filter((s) => s.status === 'Posted' || s.posted_link).length,\n      median_swipe: median(swipePosts.map((p) => p.score)),\n      median_other: median(others.map((p) => p.score)),\n      our_posts: scored.length,\n      best_score: best ? best.score : null,\n    }];\n  },\n});\n\n(() => {\n  const fx = (v) => (v === null || v === undefined ? '\u2014' : d3.format('.1f')(v) + 'x');\n  const fday = (s) => (s ? d3.utcFormat('%b %-d')(new Date(s + 'T00:00:00Z')) : '');\n  const platColor = { X: 'var(--color-fg)', LinkedIn: '#0a66c2', Instagram: '#c13584', 'Meta ad': 'var(--plum)' };\n  let filter = 'all', showAll = false;\n\n  const failIn = (el) => { el.classList.remove('dash-skeleton'); const d = document.createElement('div'); d.className = 'sc-fail'; d.textContent = 'Failed to load'; el.replaceChildren(d); };\n\n  const drawSummary = () => {\n    const s = dash.data('summary');\n    const take = document.getElementById('take');\n    const marks = document.querySelectorAll('#tiles [data-source=\"summary\"]');\n    if (s.status === 'error') { take.classList.remove('dash-skeleton'); take.textContent = 'Failed to load from Notion.'; marks.forEach((m) => m.classList.remove('dash-skeleton')); return; }\n    if (s.status !== 'ok' || !s.data.length) return;\n    const r = s.data[0];\n    marks.forEach((el) => {\n      el.classList.remove('dash-skeleton');\n      const f = el.dataset.field;\n      el.textContent = f.startsWith('median') ? fx(r[f]) : d3.format(',')(r[f]);\n    });\n    take.classList.remove('dash-skeleton');\n    const b = (field, text) => { const e = document.createElement('b'); e.dataset.source = 'summary'; e.dataset.field = field; e.dataset.row = '0'; e.textContent = text; return e; };\n    if (!r.posted) {\n      take.replaceChildren(b('written', d3.format(',')(r.written)), ' swipes are written and none is posted yet. Post one from the tracker below and Scooby finds it on our account the next morning, links it and starts comparing. Until then our usual post sits at ', b('median_other', fx(r.median_other)), '.');\n    } else {\n      take.replaceChildren(b('posted', d3.format(',')(r.posted)), ' swipes are live. Posts built on a swipe score ', b('median_swipe', fx(r.median_swipe)), ' our usual post, against ', b('median_other', fx(r.median_other)), ' for everything else.');\n    }\n  };\n\n  const drawTracker = () => {\n    const s = dash.data('tracker');\n    const tbody = document.querySelector('#swipe-table tbody');\n    if (s.status === 'error') { const td = document.createElement('td'); td.colSpan = 6; const tr = document.createElement('tr'); tr.append(td); tbody.replaceChildren(tr); failIn(td); return; }\n    if (s.status !== 'ok') return;\n    const order = { Posted: 0, Ready: 1, 'Needs confirmation': 2, Skipped: 3 };\n    const rows = s.data.filter((r) => filter === 'all' || r.status === filter || (filter === 'Posted' && r.posted_link))\n      .slice().sort((a, b) => (order[a.status] ?? 9) - (order[b.status] ?? 9) || a.swipe_id.localeCompare(b.swipe_id));\n    const max = Math.max(4, ...s.data.map((r) => Math.max(r.reference_score || 0, r.our_score || 0)));\n    if (!rows.length) { const tr = document.createElement('tr'); const td = document.createElement('td'); td.colSpan = 6; td.className = 'sc-empty'; td.textContent = 'No swipes with this status yet.'; tr.append(td); tbody.replaceChildren(tr); return; }\n    tbody.replaceChildren(...rows.map((r) => {\n      const tr = document.createElement('tr'); tr.dataset.key = r.swipe_url;\n      const what = document.createElement('td'); what.className = 'sc-what';\n      const id = document.createElement('span'); id.className = 'sc-id'; id.textContent = r.swipe_id;\n      const a = document.createElement('a'); a.href = r.swipe_url; a.target = '_blank'; a.rel = 'noopener'; a.textContent = r.swipe;\n      what.append(id, a);\n      const where = document.createElement('td'); where.className = 'sc-meta wide';\n      const dot = document.createElement('span'); dot.className = 'sc-dot'; dot.style.background = platColor[r.platform] || 'var(--color-fg-muted)';\n      where.append(dot, r.brand + ' \u00b7 ' + r.platform);\n      const st = document.createElement('td'); const pill = document.createElement('span');\n      const cls = { Ready: 'ready', 'Needs confirmation': 'confirm', Posted: 'posted', Skipped: 'skipped' }[r.status] || 'skipped';\n      pill.className = 'sc-pill ' + cls; pill.textContent = r.status === 'Needs confirmation' ? 'Needs a check' : (r.status || '\u2014'); st.append(pill);\n      const ref = document.createElement('td'); ref.className = 'n';\n      if (r.reference_link) { const ra = document.createElement('a'); ra.href = r.reference_link; ra.target = '_blank'; ra.rel = 'noopener'; ra.textContent = r.reference_score !== null ? fx(r.reference_score) : 'Ad'; ref.append(ra); } else ref.textContent = fx(r.reference_score);\n      const ours = document.createElement('td'); ours.className = 'n';\n      if (r.posted_link) { const oa = document.createElement('a'); oa.href = r.posted_link; oa.target = '_blank'; oa.rel = 'noopener'; oa.textContent = fx(r.our_score); ours.append(oa); } else ours.textContent = 'Not posted';\n      const cmp = document.createElement('td'); cmp.className = 'wide';\n      const bars = document.createElement('div'); bars.className = 'sc-bars';\n      const b1 = document.createElement('div'); b1.className = 'sc-bar ref'; b1.style.width = r.reference_score ? Math.max(4, (r.reference_score / max) * 100) + '%' : '0';\n      const b2 = document.createElement('div'); b2.className = 'sc-bar ' + (r.our_score !== null ? 'ours' : 'none'); b2.style.width = r.our_score !== null ? Math.max(4, (r.our_score / max) * 100) + '%' : '100%';\n      bars.append(b1, b2); cmp.append(bars);\n      tr.append(what, where, st, ref, ours, cmp);\n      return tr;\n    }));\n  };\n\n  const drawPosts = () => {\n    const s = dash.data('scored');\n    const list = document.getElementById('post-list');\n    const more = document.getElementById('more');\n    if (s.status === 'error') return failIn(list);\n    if (s.status !== 'ok') return;\n    const rows = s.data.slice().sort((a, b) => b.posted.localeCompare(a.posted));\n    const shown = showAll ? rows : rows.slice(0, 8);\n    more.hidden = rows.length <= 8; more.textContent = showAll ? 'Show fewer' : 'Show all ' + rows.length + ' posts';\n    list.replaceChildren(...shown.map((p) => {\n      const row = document.createElement('div'); row.className = 'sc-post';\n      const d = document.createElement('span'); d.className = 'd sc-meta'; d.textContent = fday(p.posted);\n      const t = document.createElement('span'); t.className = 't';\n      const dot = document.createElement('span'); dot.className = 'sc-dot'; dot.style.background = platColor[p.platform] || 'var(--color-fg-muted)'; dot.title = p.platform;\n      const a = document.createElement('a'); a.href = p.link; a.target = '_blank'; a.rel = 'noopener'; a.textContent = p.post || p.link;\n      t.append(dot, a);\n      const sc = document.createElement('span'); sc.className = 'sc-score' + (p.score >= 3 ? ' hot' : ''); sc.textContent = fx(p.score);\n      sc.title = d3.format(',')(p.likes || 0) + ' likes \u00b7 ' + d3.format(',')(p.comments || 0) + ' comments' + (p.reposts ? ' \u00b7 ' + p.reposts + ' reposts' : '');\n      row.append(d, t, sc);\n      return row;\n    }));\n    